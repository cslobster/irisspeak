{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install --no-audit --no-fund",
  "framework": null,
  "rewrites": [
    {
      "source": "/aac",
      "destination": "/aac/index.html"
    },
    {
      "source": "/aac/",
      "destination": "/aac/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
