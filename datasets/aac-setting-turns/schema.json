{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC setting turn",
  "type": "object",
  "required": ["setting", "question", "cards"],
  "additionalProperties": false,
  "properties": {
    "setting": {
      "type": "string",
      "description": "Where the conversation happens.",
      "enum": ["home", "school", "restaurant", "doctor", "play", "transport", "selfcare"]
    },
    "question": {
      "type": "string",
      "description": "What the partner (parent, teacher, carer, clinician) asks.",
      "minLength": 1, "maxLength": 120
    },
    "cards": {
      "type": "array",
      "description": "The child's reply, as the picture cards they tap in order.",
      "minItems": 1, "maxItems": 4,
      "items": {"type": "string", "minLength": 1, "maxLength": 24}
    },
    "_batch": {
      "type": "string",
      "description": "Provenance: the generation batch this row came from (setting:prompt-version:index)."
    }
  }
}
